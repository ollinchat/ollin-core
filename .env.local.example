# Optional: Supabase for remote persistence of Board, Profile, and Scans.
# Copy to .env.local and set values. If unset, the app uses localStorage only.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Explore live data (Phase 2): set one for real local news/deals search. If unset, fallback to DuckDuckGo.
# TAVILY_API_KEY=your-tavily-api-key
# SERPER_API_KEY=your-serper-api-key
